{
  "name": "@openchart/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./agent": "./agent/index.ts",
    "./agent/*": "./agent/*.ts",
    "./agent/plugin": "./agent/plugin/plugin.ts",
    "./agent/session/execution": "./agent/session/execution/execution.ts",
    "./agent/session/runner": "./agent/session/runner/runner.ts",
    "./agent/workflow": "./agent/workflow/workflow.ts",
    "./agent/workflow/authoring": "./agent/workflow/authoring/index.ts",
    "./runtime": "./runtime.ts",
    "./context": "./context.ts",
    "./contract": {
      "types": "./contract.ts"
    },
    "./db": "./db/database.ts",
    "./db/*": "./db/*.ts",
    "./events": "./events/index.ts",
    "./lib/errors": "./lib/errors/index.ts",
    "./lib/resource": "./lib/resource/index.ts",
    "./lib/resource/*": "./lib/resource/*.ts",
    "./lib/trpc": "./lib/trpc/trpc.ts",
    "./lib/trpc/resource-router": "./lib/trpc/resource-router.ts",
    "./resources/router": "./resources/router.ts",
    "./resources/macros/*": "./resources/macros/*.ts",
    "./resources/*/schema": "./resources/*/schema.ts",
    "./resources/*": "./resources/*/resource.ts",
    "./config": "./config/provider.ts",
    "./config/*": "./config/*.ts",
    "./config/provider": "./config/provider.ts",
    "./models": "./models/models.ts",
    "./models/*": "./models/*.ts",
    "./favicon/router": "./favicon/router.ts",
    "./agent/session": "./agent/session/session.ts",
    "./resources/catalog": "./resources/catalog.ts",
    "./resources/agent-schedule/*": "./resources/agent-schedule/*.ts",
    "./resources/agent-schedule-occurrence/*": "./resources/agent-schedule-occurrence/*.ts",
    "./scheduler": "./scheduler/scheduler.ts",
    "./scheduler/router": "./scheduler/router.ts",
    "./agent/permission": "./agent/permission/permission.ts",
    "./agent/question": "./agent/question/question.ts",
    "./agent/llm": "./agent/llm/llm.ts",
    "./home": "./home.ts",
    "./home.test-utils": "./home.test-utils.ts",
    "./workspace/*": "./workspace/*.ts",
    "./resources/workspace/*": "./resources/workspace/*.ts",
    "./notification": "./notification/notification.ts",
    "./proactive/*": "./proactive/*.ts",
    "./notification/config": "./notification/config.ts"
  },
  "scripts": {
    "check": "npm run db:check && tsc -p tsconfig.json && vitest run",
    "db:check": "node --experimental-strip-types db/generate.ts --check",
    "db:generate": "node --experimental-strip-types db/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@openchart/agent": "workspace:*",
    "htmlparser2": "12.0.0",
    "request-filtering-agent": "3.2.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "@openchart/models": "workspace:*",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "croner": "10.0.1",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.112",
    "fast-json-patch": "^3.1.1",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5",
    "@openchart/identifier": "workspace:*",
    "@openchart/utils": "workspace:*",
    "ai": "7.0.79",
    "@ai-sdk/provider": "4.0.8",
    "jsonrepair": "3.14.0",
    "@ag-ui/core": "0.0.59",
    "@effect/platform-node": "4.0.0-rc.112",
    "chokidar": "5.0.0",
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@opentelemetry/otlp-transformer": "0.213.0",
    "@opentelemetry/sdk-trace-base": "2.6.0",
    "tar": "7.5.22",
    "@openchart/notification": "workspace:*",
    "@opentelemetry/api": "1.9.0"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "prettier": "^3.8.1",
    "@ag-ui/client": "0.0.59",
    "eventsource": "3.0.7",
    "@openchart/app": "workspace:*",
    "@tanstack/react-query": "^5.32.0"
  }
}
