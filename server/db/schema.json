    {
      "value": "\"role\" IN ('user', 'assistant')",
      "name": "chk_agent_messages_role",
      "entityType": "checks",
      "table": "agent_messages"
    },
    {
      "value": "\n      json_valid(\"data\") AND json_type(\"data\") = 'object'\n      AND json_type(\"data\", '$.id') IS NULL\n      AND json_type(\"data\", '$.sessionID') IS NULL\n      AND json_type(\"data\", '$.role') IS NULL\n    ",
      "name": "chk_agent_messages_data_columns",
      "entityType": "checks",
      "table": "agent_messages"
    },
    {
      "value": "\n      json_valid(\"data\") AND json_type(\"data\") = 'object'\n      AND json_type(\"data\", '$.id') IS NULL\n      AND json_type(\"data\", '$.messageID') IS NULL\n      AND json_type(\"data\", '$.sessionID') IS NULL\n    ",
      "name": "chk_agent_parts_data_columns",
      "entityType": "checks",
      "table": "agent_parts"
    },
    {
      "value": "\"status\" IN ('queued', 'running', 'completed', 'stop', 'failed')",
      "name": "agent_run_status_check",
      "entityType": "checks",
      "table": "agent_run"
    },
    {
      "value": "(\n        \"status\" = 'queued'\n        AND \"queue_position\" IS NOT NULL\n        AND \"started_at\" IS NULL\n        AND \"finished_at\" IS NULL\n      ) OR (\n        \"status\" = 'running'\n        AND \"queue_position\" IS NULL\n        AND \"started_at\" IS NOT NULL\n        AND \"finished_at\" IS NULL\n      ) OR (\n        \"status\" IN ('completed', 'stop', 'failed')\n        AND \"queue_position\" IS NULL\n        AND \"started_at\" IS NOT NULL\n        AND \"finished_at\" IS NOT NULL\n      )",
      "name": "agent_run_lifecycle_check",
      "entityType": "checks",
      "table": "agent_run"
    },
    {
      "value": "json_valid(\"input\")\n        AND json_type(\"input\") = 'object'\n        AND NULLIF(json_extract(\"input\", '$.agent'), '') IS NOT NULL\n        AND NULLIF(\n          json_extract(\"input\", '$.model.providerID'),\n          ''\n        ) IS NOT NULL\n        AND NULLIF(\n          json_extract(\"input\", '$.model.modelID'),\n          ''\n        ) IS NOT NULL\n        AND json_type(\"input\", '$.parts') = 'array'\n        AND json_array_length(\"input\", '$.parts') > 0",
      "name": "agent_run_input_check",
      "entityType": "checks",
      "table": "agent_run"
    },
    {
      "value": "trim(\"key\") <> ''",
      "name": "chk_agent_session_bindings_key",
      "entityType": "checks",
      "table": "agent_session_bindings"
    },
    {
      "value": "\"kind\" in ('chat', 'delegate', 'dig_in', 'scheduled')",
      "name": "agent_sessions_kind_check",
      "entityType": "checks",
      "table": "agent_sessions"
    },
    {
      "value": "\"id\" IS NOT NULL",
      "name": "agent_schedule_occurrence_id_check",
      "entityType": "checks",
      "table": "agent_schedule_occurrence"
    },
    {
      "value": "\"revision\" >= 1",
      "name": "agent_schedule_occurrence_revision_check",
      "entityType": "checks",
      "table": "agent_schedule_occurrence"
    },
    {
      "value": "\"created_at\" >= 0",
      "name": "agent_schedule_occurrence_created_at_check",
      "entityType": "checks",
      "table": "agent_schedule_occurrence"
    },
    {
      "value": "\"updated_at\" >= 0",
      "name": "agent_schedule_occurrence_updated_at_check",
      "entityType": "checks",
      "table": "agent_schedule_occurrence"
    },
    {
      "value": "\"id\" IS NOT NULL",
      "name": "agent_schedule_id_check",
      "entityType": "checks",
      "table": "agent_schedule"
    },
    {
      "value": "\"revision\" >= 1",
      "name": "agent_schedule_revision_check",
      "entityType": "checks",
      "table": "agent_schedule"
    },
    {
      "value": "\"created_at\" >= 0",
      "name": "agent_schedule_created_at_check",
      "entityType": "checks",
      "table": "agent_schedule"
    },
    {
      "value": "\"updated_at\" >= 0",
      "name": "agent_schedule_updated_at_check",
      "entityType": "checks",
      "table": "agent_schedule"
    },
    {
      "value": "length(trim(\"name\")) BETWEEN 1 AND 160",
      "name": "chk_agent_schedules_name",
      "entityType": "checks",
      "table": "agent_schedule"
    },
    {
      "value": "json_type(\"target_json\") = 'object'",
      "name": "chk_agent_schedules_target_object",
      "entityType": "checks",
      "table": "agent_schedule"
    },
    {
      "value": "CASE json_extract(\"target_json\", '$.kind')\n      WHEN 'agent_prompt' THEN COALESCE(\n        json_type(\"target_json\", '$.prompt.model') = 'object'\n        AND json_type(\"target_json\", '$.prompt.model.providerID') = 'text'\n        AND length(json_extract(\"target_json\", '$.prompt.model.providerID')) > 0\n        AND json_extract(\"target_json\", '$.prompt.model.providerID') <> 'unknown'\n        AND json_type(\"target_json\", '$.prompt.model.modelID') = 'text'\n        AND length(json_extract(\"target_json\", '$.prompt.model.modelID')) > 0\n        AND json_extract(\"target_json\", '$.prompt.model.modelID') <> 'unknown'\n        AND (\n          json_type(\"target_json\", '$.prompt.model.selectedVariant') IS NULL\n          OR (\n            json_type(\"target_json\", '$.prompt.model.selectedVariant') = 'text'\n            AND length(json_extract(\"target_json\", '$.prompt.model.selectedVariant')) > 0\n          )\n        )\n        AND json(json_remove(\n          json_extract(\"target_json\", '$.prompt.model'),\n          '$.providerID',\n          '$.modelID',\n          '$.selectedVariant'\n        )) = '{}',\n        0\n      )\n      ELSE 0\n      END",
      "name": "chk_agent_schedules_target",
      "entityType": "checks",
      "table": "agent_schedule"
    },
    {
      "value": "COALESCE(\n        (\n          json_extract(\"recurrence\", '$.kind') = 'cron'\n          AND length(\n              trim(json_extract(\"recurrence\", '$.expression'))\n            ) > 0\n          AND length(\n              trim(json_extract(\"recurrence\", '$.timeZone'))\n            ) > 0\n        ) OR (\n          json_extract(\"recurrence\", '$.kind') = 'once'\n          AND json_type(\"recurrence\", '$.fireAt') = 'text'\n          AND length(\n              trim(json_extract(\"recurrence\", '$.fireAt'))\n            ) > 0\n        ),\n        0\n      )",
      "name": "chk_agent_schedules_recurrence_shape",
      "entityType": "checks",
      "table": "agent_schedule"
    },
    {
      "value": "\"id\" IS NOT NULL",
      "name": "workspace_id_check",
      "entityType": "checks",
      "table": "workspace"
    },
    {
      "value": "\"revision\" >= 1",
      "name": "workspace_revision_check",
      "entityType": "checks",
      "table": "workspace"
    },
    {
      "value": "\"created_at\" >= 0",
      "name": "workspace_created_at_check",
      "entityType": "checks",
      "table": "workspace"
    },
    {
      "value": "\"updated_at\" >= 0",
      "name": "workspace_updated_at_check",
      "entityType": "checks",
      "table": "workspace"
    },
    {
      "value": "length(\"root\") > 0",
      "name": "workspace_root_check",
      "entityType": "checks",
      "table": "workspace"
    }
